#!/usr/bin/env bash
# Launcher:  ./run ISRG   |   ./run --list holdings   |   ./run --rollup holdings   |   ./run --fetch all
# (uv downloads the packages the script needs the first time; pywin32 lets --rollup read values through Excel.)
case "$(uname -s)" in MINGW*|MSYS*|CYGWIN*) win="--with pywin32" ;; *) win="" ;; esac   # pywin32 only exists on Windows
cd "$(dirname "$0")" && exec uv run --with requests --with pandas --with openpyxl $win python edgar_etl.py "$@"

#!/usr/bin/env bash
# Launcher:  ./run ISRG   |   ./run --list holdings   |   ./run --rollup holdings   |   ./run --fetch all
# (uv downloads the packages the script needs the first time; pywin32 lets --rollup read values through Excel.)
cd "$(dirname "$0")" && exec uv run --with requests --with pandas --with openpyxl --with pywin32 python edgar_etl.py "$@"
